# Any OpenAI-compatible server. LM Studio's default:
LLM_BASE_URL=http://localhost:1234/v1
# The model id as the server lists it (LM Studio: `lms ls`, or GET /v1/models)
LLM_MODEL=qwen/qwen3-14b
# Not needed for LM Studio; set it for a hosted API
LLM_API_KEY=not-needed
# 1 = add /no_think so Qwen3-style models skip hidden reasoning (much faster); 0 = let them think
LLM_NO_THINK=1
