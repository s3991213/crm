# Where the FastAPI backend is running
CRM_API_BASE_URL=http://localhost:8000
# Seconds to wait for the backend before asking the user to retry
CRM_API_TIMEOUT=60

# Signs login sessions. Generate your own with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
CRM_SESSION_SECRET="replace-me"
# Set to 1 when the app is served over https, so the session cookie is only ever sent encrypted
CRM_HTTPS=0
