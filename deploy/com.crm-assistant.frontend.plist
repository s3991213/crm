<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Staff app on :8080. Starts at login and restarts if it crashes (not after a clean stop).
     It listens on 127.0.0.1 only; to open it to the office network set HOST to 0.0.0.0, and read
     "https on the office network" in deploy/README.md first. deploy/install.sh fills in __ROOT__, __LOGS__, __PATH__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.crm-assistant.frontend</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/run.sh</string>
    <string>frontend</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Includes Node.js, which run.sh needs to rebuild the staff app after its source changes -->
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOST</key>
    <string>127.0.0.1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__LOGS__/frontend.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/frontend.log</string>
</dict>
</plist>
